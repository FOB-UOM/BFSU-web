# Supabase Configuration
# Obtain from your Supabase Dashboard: Project Settings > API & Project Settings > Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional: Local Supabase CLI Access Token for isolated migrations
# Generate from: https://supabase.com/dashboard/account/tokens
# Keep empty in production (Vercel)
SUPABASE_ACCESS_TOKEN=sbp_v0_your_personal_access_token

# Notion Headless CMS Configuration
# Create an Internal Integration at: https://www.notion.so/profile/integrations
NOTION_API_KEY=ntn_your_notion_integration_secret_here

# Notion Database IDs (Extracted from each database share URL before '?v=')
NOTION_NEWS_DB_ID=your_news_database_id_here
NOTION_EVENTS_DB_ID=your_events_database_id_here
NOTION_COUNCIL_DB_ID=your_council_database_id_here
NOTION_SOCIETIES_DB_ID=your_societies_database_id_here
NOTION_WELFARE_DB_ID=your_welfare_database_id_here

# Cloudflare (BFSU Workspace Profile)
# Generate a scoped API token with Zone.DNS edit permissions at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your_bfsu_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_bfsu_cloudflare_account_id

# Vercel Project Link (Optional environment overrides)
VERCEL_ORG_ID=your_vercel_org_or_team_id
VERCEL_PROJECT_ID=your_vercel_project_id
